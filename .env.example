# THRIFT Signaling Server — Environment Variables
# Copy this file to .env and configure as needed.

# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Frontend Origin ───
# Development: http://localhost:5173
# Production: set to your actual deployed frontend URL (e.g., https://thrift.example.com)
FRONTEND_ORIGIN=http://localhost:5173

# ─── Session Configuration ───
# Session time-to-live in milliseconds (default: 600000 = 10 minutes)
SESSION_TTL_MS=600000
# Inactivity timeout after pairing (default: 300000 = 5 minutes)
SESSION_IDLE_TIMEOUT_MS=300000
# How often to sweep for expired sessions (default: 15000 = 15 seconds)
SESSION_CLEANUP_INTERVAL_MS=15000

# ─── Reconnection Grace Period ───
# Grace window to hold session in memory when a peer drops (default: 30000 = 30 seconds)
RECONNECT_GRACE_MS=30000

# ─── WebSocket ───
# Maximum message size in bytes (default: 65536 = 64 KB)
WS_MAX_MESSAGE_SIZE=65536
# Heartbeat ping interval (default: 30000 = 30 seconds)
WS_HEARTBEAT_INTERVAL_MS=30000
# Pong timeout (default: 10000 = 10 seconds)
WS_PONG_TIMEOUT_MS=10000

# ─── Rate Limiting ───
# CREATE_SESSION: max 5 per minute per IP
RL_CREATE_WINDOW_MS=60000
RL_CREATE_MAX=5
# JOIN_SESSION: max 10 per minute per IP
RL_JOIN_WINDOW_MS=60000
RL_JOIN_MAX=10
# Invalid token attempts: max 5 per minute per IP
RL_INVALID_TOKEN_WINDOW_MS=60000
RL_INVALID_TOKEN_MAX=5
# WebSocket connections: max 20 per minute per IP
RL_WS_CONNECT_WINDOW_MS=60000
RL_WS_CONNECT_MAX=20
# Signaling messages: max 50 per 10 seconds per IP
RL_SIGNALING_WINDOW_MS=10000
RL_SIGNALING_MAX=50

# ─── ICE & STUN/TURN Servers (for WebRTC) ───
# Comma-separated list of STUN server URLs
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Comma-separated list of TURN server URLs (e.g. turn:turn.example.com:3478?transport=udp)
TURN_SERVERS=
# Static credentials (legacy fallback)
TURN_USERNAME=
TURN_CREDENTIAL=
# Ephemeral TURN credentials (Coturn static-auth-secret mode — recommended for zero-cost self-hosting)
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_S=21600

# ─── E2EE Relay Fallback ───
# Maximum relayed bytes per session before cutoff (default: 524288000 = 500 MB)
RELAY_MAX_BYTES=524288000
RELAY_CHUNK_SIZE=65536
RL_RELAY_WINDOW_MS=1000
RL_RELAY_MAX=100

# ─── Logging ───
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
