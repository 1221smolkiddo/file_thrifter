# THRIFT Client — Environment Variables
# Copy this file to .env and configure as needed.

# ─── WebSocket Signaling Endpoint ───
# In local development: defaults to ws://localhost:4000 (auto-derived)
# In production: set to your deployed signaling server URL (e.g., wss://api.yourdomain.com or wss://thrift-server.onrender.com)
VITE_WS_URL=
